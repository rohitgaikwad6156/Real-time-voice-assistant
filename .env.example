# ==============================================================================
# BACKEND / RENDER ENVIRONMENT VARIABLES (Private Secrets & Server Configuration)
# Keep these in your Render Dashboard (Environment) or local .env. NEVER expose to frontend.
# ==============================================================================

# Google Gemini API Configuration (Real-Time Voice Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VOICE_NAME=Puck

# Weather API Configuration (Default: open-meteo requires no key)
WEATHER_API_KEY=open-meteo
WEATHER_API_PROVIDER=open-meteo

# Server Port & Allowed Frontend Origins for CORS
PORT=10000
FRONTEND_URL=https://your-app-name.vercel.app

# Database Configuration (Optional: defaults to assistant.db)
DATABASE_PATH=assistant.db

# Legacy OpenAI Configuration (Optional: for legacy REST endpoints)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.6
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ==============================================================================
# FRONTEND / VERCEL ENVIRONMENT CONFIGURATION (Optional Public Overrides)
# These may be configured in Vercel if overriding default backend detection.
# ==============================================================================
# VOICE_ASSISTANT_API_URL=https://real-time-voice-assistant-9bh1.onrender.com
# VOICE_ASSISTANT_WS_URL=wss://real-time-voice-assistant-9bh1.onrender.com/ws/voice
