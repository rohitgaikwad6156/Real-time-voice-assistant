# ==============================================================================
# BACKEND / RENDER ENVIRONMENT VARIABLES
# Keep private secrets only in Render or local .env. Never expose them in frontend code.
# ==============================================================================

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VOICE_NAME=Puck

# MongoDB Atlas - required for login, conversation history and per-user reminders
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=voice_assistant

# JWT Authentication
JWT_SECRET=generate_a_long_random_secret_here
JWT_EXPIRE_MINUTES=10080

# Weather API Configuration
WEATHER_API_KEY=open-meteo
WEATHER_API_PROVIDER=open-meteo

# Server / CORS
PORT=10000
FRONTEND_URL=https://real-time-voice-assistant-lovat.vercel.app

# Legacy SQLite path (only used by old local/test note/reminder helpers)
DATABASE_PATH=assistant.db

# Legacy OpenAI REST endpoints (optional)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.6
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Frontend public overrides (normally not needed)
# VOICE_ASSISTANT_API_URL=https://real-time-voice-assistant-9bh1.onrender.com
# VOICE_ASSISTANT_WS_URL=wss://real-time-voice-assistant-9bh1.onrender.com/ws/voice
